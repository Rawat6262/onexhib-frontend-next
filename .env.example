# Base URL of the existing Express API. Server-only: read by next.config.mjs to
# proxy /api/* . Deliberately NOT prefixed NEXT_PUBLIC_ — the browser must never
# receive it, and no secret belongs in this file.
BACKEND_URL=http://localhost:8001

# Browser notifications (lib/web-push.js, public/push-sw.js). All five are
# PUBLIC values that the browser needs; none is a secret. From the Firebase
# project the app and backend already use:
#   Project settings > General > Your apps > Web app  -> the first four
#   Project settings > Cloud Messaging > Web Push certificates > Key pair -> VAPID
# Leave any of them empty and the website shows no notification controls.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
